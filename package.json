{
  "name": "company-os",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=26.0.0"
  },
  "scripts": {
    "lint": "eslint .",
    "lint:boundaries": "depcruise apps packages",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "build": "npm run build --workspaces --if-present",
    "ports:check": "node scripts/ports-check.mjs",
    "env:check": "node scripts/env-vars.mjs",
    "storage:smoke": "node scripts/storage-smoke.mjs",
    "storage:check": "node scripts/backup/cli.mjs storage-check",
    "backup:create": "node scripts/backup/cli.mjs create",
    "backup:verify": "node scripts/backup/cli.mjs verify",
    "backup:list": "node scripts/backup/cli.mjs list",
    "backup:prune": "node scripts/backup/cli.mjs prune",
    "backup:schedule": "node scripts/backup/cli.mjs schedule",
    "restore": "node scripts/backup/cli.mjs restore",
    "db:app-access": "npm run db:app-access --workspace @company-os/platform --"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1161.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "dependency-cruiser": "^18.7.2",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  }
}
