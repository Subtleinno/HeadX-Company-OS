# 複製本檔為 .env 後再啟動：copy .env.example .env
# 端口可以改；改完先跑 npm run ports:check

# 必填：Postgres 帳密
POSTGRES_USER=company_os
# 密碼必須自行設定；留空或未設定時 docker compose 會即時失敗，不會用任何預設值
POSTGRES_PASSWORD=
POSTGRES_DB=company_os

# 必填：檔案儲存（MinIO）帳密
MINIO_ROOT_USER=company-os
# 密碼必須自行設定；留空時 docker compose 會即時失敗。正式環境請用隨機字串
MINIO_ROOT_PASSWORD=
MINIO_BUCKET=company-os
# 資料放哪個資料夾（bind mount，不是 Docker volume）。Windows 路徑用正斜線：
# MINIO_DATA_DIR=D:/company-os-data/minio
# 留空時用 repo 內的 ./.data/minio，只適合試用；正式資料請指向 repo 以外的地方
MINIO_DATA_DIR=./.data/minio

# 對外端口（預設值）
# gateway-internal 原本叫 WEB_PORT（S1-02／#78 改名）。舊名仍然生效，但會提示更新；
# 只有 WEB_PORT 的舊 .env 不用改也可以照樣啟動。
GATEWAY_INTERNAL_PORT=4210
API_PORT=4420
# app-host（profile apps，要 --profile apps 才會啟動）。只屬大陸版，國際版沒有這個容器。
APPS_PORT=4431
# app-host 要載入哪些 app（逗號分隔，例如 sales,hr）。留空即不載入任何 app，容器照樣健康。
# 每個 app 都要有自己的資料庫帳號 APP_DB_<ID>_USER／APP_DB_<ID>_PASSWORD，寫在這個檔案裡
# （不寫進 compose）。
APP_SET=
DB_PORT=25432
PORT_MINIO_API=29000
PORT_MINIO_CONSOLE=29001

# 單一檔案上傳上限（bytes）。預設 200 MiB，與 apps/web/nginx.conf 的 client_max_body_size 一致；
# 兩邊要一起改，nginx 那個不改的話瀏覽器上傳會在 1 MiB 被擋。不是秘密。
MAX_UPLOAD_BYTES=209715200

# session cookie 是否加 Secure。本機用 http，留 false；
# 將來經 HTTPS 入口（反向代理）時改成 true，否則瀏覽器不會存 cookie。
COOKIE_SECURE=false

# 必填：登入失敗審計的 HMAC key。登入失敗時系統要把 email 變成不可逆的識別碼
# 才寫進 audit_log（那張表只准追加，寫錯就永遠拿不走）。
# 未設定時 API 會拒絕啟動；少於 32 bytes 會在啟動時出警告。
# 產生方法（32 bytes 隨機）：
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
# 換 key 之後，舊的失敗紀錄與新的識別碼不再對應，窗口內的限流計數會失效 —— 見 README。
LOGIN_FAILURE_HASH_KEY=

# ── 備份（issue #61）────────────────────────────────────────────────────────
# 必填：備份根目錄。必須是 C: 以外的另一粒實體碟，寫在同一粒碟上等於沒有備份。
# 未設定、不存在、不可寫入、或位於資料目錄之內時，備份會拒絕執行。
# Windows 路徑用正斜線，例如：
# COMPANY_OS_BACKUP_ROOT=D:/company-os-backups
COMPANY_OS_BACKUP_ROOT=

# 資料根目錄（Postgres 與 MinIO 的資料所在）。備份根目錄不可以放在它之內。
# 留空時只保護 MINIO_DATA_DIR 與 repo 資料夾本身。
# COMPANY_OS_DATA_ROOT=C:/company-os-data

# 保留幾份「已驗證」的備份。永遠不會刪掉最後一份有效備份。
BACKUP_RETENTION=7

# 排程備份間隔（小時）。0 表示只跑一次，不進入迴圈。
BACKUP_INTERVAL_HOURS=24

# 備份期間要暫停的容器：它們是唯一會寫入 Postgres 與 MinIO 的程式。
# 停不掉時備份會失敗，不會產生一份不一致的備份。
BACKUP_QUIESCE_CONTAINERS=company-os-api-1
