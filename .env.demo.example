# Demo Public Stack 的環境變數範本（issue #145／決策 C52）
#
# 複製為 .env.demo 之後再填：
#   cp .env.demo.example .env.demo
#
# 規則：
#   1. 本檔不可以有任何可用的密碼或 token。所有 secret 一律留空。
#   2. .env.demo 不進 git（.gitignore 已忽略 .env.*，只放行這份範本）。
#   3. 不要把正式的 .env 內容抄過來。Demo 與正式用完全不同的資料庫、storage 與帳號；
#      共用任何一個值就等於兩邊打通。
#   4. 這些值只影響 Demo project（company-os-demo），正式 stack 讀的是 .env，不會讀本檔。

# ── 資料庫（必填）─────────────────────────────────────────────────────────────
# 一定要叫 company_os_demo，不要用正式的 company_os。
DEMO_POSTGRES_USER=company_os_demo
# 留空時 docker compose 會即時失敗，不會用任何預設值。
# 產生方法：node -e "console.log(require('node:crypto').randomBytes(24).toString('base64url'))"
DEMO_POSTGRES_PASSWORD=
DEMO_POSTGRES_DB=company_os_demo

# ── 檔案儲存（必填）───────────────────────────────────────────────────────────
DEMO_MINIO_ROOT_USER=demo-storage
DEMO_MINIO_ROOT_PASSWORD=
# bucket 名要與正式不同（正式是 company-os）。
DEMO_MINIO_BUCKET=company-os-demo

# ── API ──────────────────────────────────────────────────────────────────────
DEMO_MAX_UPLOAD_BYTES=209715200
# 公開 Demo 走 Cloudflare 隧道（HTTPS），所以 true。
# 若用 docker-compose.demo.local.yml 以 http://127.0.0.1:<port> 除錯，必須改 false，
# 否則瀏覽器不會存 session cookie，登入會「看似失敗」。
DEMO_COOKIE_SECURE=true
# 必填：登入失敗審計用的 HMAC key。與正式的 key 不同。
DEMO_LOGIN_FAILURE_HASH_KEY=

# ── 入口憑證（必填）───────────────────────────────────────────────────────────
# 至少 32 bytes 的 hex（64 個以上 0-9 a-f 字元）。與正式的 token 不同。
# 產生方法：node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
DEMO_INTERNAL_GATEWAY_TOKEN=

# ── Cloudflare Tunnel ────────────────────────────────────────────────────────
# 只可以是「指向 Demo 子網域」那條 tunnel 的 token。留空時 cloudflared 會自己失敗。
# token 屬於 secret：只放在 .env.demo 或密碼管理工具，不進 repo、不進 issue、不進截圖。
DEMO_CLOUDFLARE_TUNNEL_TOKEN=

# ── 本機除錯端口（只有 docker-compose.demo.local.yml 會讀）──────────────────
# 全部綁 127.0.0.1，且刻意不與正式 stack 的端口重複
# （正式：4210／4420／4431／25432／29000／29001）。公開 Demo 不需要這些。
DEMO_GATEWAY_INTERNAL_PORT=4610
DEMO_API_PORT=4620
DEMO_DB_PORT=26532
DEMO_MINIO_API_PORT=29200
DEMO_MINIO_CONSOLE_PORT=29201

# ── 備份（預設不要對 Demo 跑）───────────────────────────────────────────────
# 備份腳本預設暫停的是**正式** stack 的 API 容器。如果真的要在同一部機對 Demo 跑
# 備份，必須同時覆寫下面兩項，否則會停到正式 API、並把 Demo 資料寫進正式備份目錄。
# BACKUP_QUIESCE_CONTAINERS=company-os-demo-api-1
# COMPANY_OS_BACKUP_ROOT=
